{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@cs/tokens": [
        "../../packages/tokens/tokens.ts"
      ],
      "@cs/db": [
        "../../packages/db/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/**/*.ts"
  ]
}
