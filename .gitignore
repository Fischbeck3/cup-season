.DS_Store
node_modules/
.netlify/
.env
*.local
.claude/settings.local.json

# Database dumps live in the repo root and carry auth.users — real emails,
# encrypted_password, refresh + session tokens. This repo is PUBLIC. Root-level
# only, so supabase/migrations/*.sql is untouched and still tracked.
/*.sql

# Build output (assembled by stamp-version.sh)
dist/

# Handoff PDF exports — regenerable binaries; their HTML sources are tracked
# alongside in spec/handoffs/.
spec/handoffs/*.pdf

# IBM Plex Mono (OFL) — fetched by tools/make-icons.py's instructions, only
# needed to regenerate the brand lockups. Binaries stay out of the repo.
tools/fonts/
.claude/worktrees/
apps/ios/build/

# The 2026-08-31 ship audit's raw output. This repo is PUBLIC. The synthesis
# names live line numbers, prod identifiers and — in §5 — the owner's personal
# legal and financial exposure. Its own README forbids publication before the
# S1/S3 fixes are LIVE, and the redaction question (which applies to all four
# audit folders, ~25 files of which carry jerecho+blind* aliases) is the
# owner's call, not a side effect of `git add -A`. Un-ignore deliberately.
docs/audit/ship-2026-08-31/
